// Code signing for Nobles Tools.
//
// The project is generated from project.yml, so set signing here rather than in Xcode's
// Signing & Capabilities tab: edits made there are replaced the next time CI regenerates the
// project. To sign with a different team on your Mac only, create Config/Local.xcconfig (it's
// gitignored) with your Team ID, which Xcode shows under Settings → Accounts:
//
//     DEVELOPMENT_TEAM = ABCDE12345
DEVELOPMENT_TEAM = 6W4ZKDHBVD

#include? "Local.xcconfig"
